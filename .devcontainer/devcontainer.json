{
  "name": "Nav Beacon",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/Nav-Beacon",

  // OpenSpec reports anonymous usage and checks npm for a newer release on
  // every run; this project sends nothing out and pins the version in the
  // lockfile, so both are off. The one variable turns off both.
  "containerEnv": {
    "ASPNETCORE_ENVIRONMENT": "Development",
    "ASPNETCORE_HTTP_PORTS": "5080",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "OPENSPEC_TELEMETRY": "0",
    "ConnectionStrings__NavBeacon": "Host=database;Database=navbeacon;Username=postgres;SSL Mode=Disable"
  },

  // The OpenSpec skills invoke the bare `openspec` binary. It is a
  // devDependency, so `node_modules/.bin` has to be on the path for that to
  // resolve without a global install.
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/node_modules/.bin:${containerEnv:PATH}"
  },

  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    }
  },

  // Persist Claude state from the host. Codex state remains container-local;
  // its writable defaults are seeded by the Dockerfile.
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/node/.claude,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude.json,target=/home/node/.claude.json,type=bind"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "angular.ng-template",
        "ms-playwright.playwright",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "anthropic.claude-code",
        "openai.chatgpt",
        "ms-dotnettools.csdevkit"
      ]
    }
  },

  "forwardPorts": [1455, 4200, 4300, 4400, 5080],

  "portsAttributes": {
    "1455": {
      "label": "Codex login callback",
      "onAutoForward": "silent",
      "requireLocalPort": true
    },
    "4200": {
      "label": "Angular dev server",
      "onAutoForward": "openBrowser"
    },
    "4300": {
      "label": "Component preview catalogue",
      "onAutoForward": "silent"
    },
    "4400": {
      "label": "Production build (offline journey)",
      "onAutoForward": "silent"
    },
    "5080": {
      "label": "Commander service",
      "onAutoForward": "silent"
    }
  },

  "remoteUser": "node",
  "postCreateCommand": "node --version && python3 --version && pnpm --version && dotnet --version && pnpm install --frozen-lockfile && pnpm run server:restore && pnpm run server:build && pnpm run server:migrate && pnpm run server:test && pnpm exec playwright install --with-deps chromium firefox"
}
