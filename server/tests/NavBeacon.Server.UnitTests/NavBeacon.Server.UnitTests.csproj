<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NavBeacon.Server/NavBeacon.Server.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures/**/*.mjs" CopyToOutputDirectory="PreserveNewest" />
    <!-- The shipped file itself, so the logging test reads what the server reads. -->
    <None
      Include="../../src/NavBeacon.Server/appsettings.json"
      Link="appsettings.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
